  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.1",
    "express": "5.3.0",
    "zod": "4.6.7",
    "pg": "8.23.1"
  },
  "devDependencies": {
    "@types/express": "5.0.6",
    "@types/node": "22.20.5",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "@types/pg": "8.23.1"
  }
}
